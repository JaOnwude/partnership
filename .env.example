# Copy to .env.local and fill in. Never commit .env.local.

# Neon connection string (Dashboard > Connect, pooled connection, sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32+ random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Dev-only 6-digit PIN given to every seeded user by `npm run seed`
SEED_PIN=123456

# 64 hex chars; encrypts members' bank details. Keep it safe: losing it makes saved details unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_DETAILS_KEY=
